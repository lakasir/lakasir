# Optional. Tests read the connection settings from phpunit.xml and fall back
# to your .env for credentials, so you only need this file when the test
# database lives on a different host or user than the app database.
CACHE_DRIVER=array
DB_CONNECTION=testing
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE_TESTING=lakasir_testing
DB_USERNAME=root
DB_PASSWORD=
APP_KEY=
