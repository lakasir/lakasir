# Modules are installed at runtime (zip/registry) and stay untracked. A module
# under development is committed as a submodule: add a `!/modules/<Name>` line
# below it. The trailing slash matters — `!/modules/<Name>/` does not re-include.
/modules/*
# !/modules/Warehouse

# Local tooling and scratch files (not part of the project)
.agents/
.claude/
.github/copilot-instructions.md
# Database dumps and backups dropped in the project root
/*.sql
docker-compose.yml.bak
modules-*-backup-*.json

# Per-machine test env (was tracked with another machine's DB values)
.env.testing
