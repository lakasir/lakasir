# ──────────────────────────────────────────────────────────────
# Production Environment Template
# Copy this to .env on your server and fill in the values
# ──────────────────────────────────────────────────────────────

APP_NAME=Lakasir
APP_ENV=production
APP_KEY=                         # ← Generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=https://your-domain.com  # ← Your Cloudflared tunnel domain

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lakasir
DB_USERNAME=lakasir
DB_PASSWORD=                     # ← Set a strong password

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Docker image tag (set automatically by deploy script) ──
IMAGE_TAG=latest
GITHUB_REPO=sheenazien8/lakasir

# ── Cloudflared / Tunnel ──
# No special env needed - Cloudflared runs separately and
# proxies traffic to this app's port 80